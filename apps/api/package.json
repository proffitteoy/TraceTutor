{
  "name": "@tracetutor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "questions:import": "tsx src/cli/import-questions.ts",
    "questions:validate": "tsx src/cli/validate-question-jsonl.ts",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "dotenv": "17.2.3",
    "fastify": "5.6.2",
    "openai": "6.9.1",
    "pg": "^8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
