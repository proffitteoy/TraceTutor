# API 监听配置
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# OpenAI-compatible 模型 API。可以指向本机推理服务或受控模型网关。
# Ollama 的兼容地址通常是 http://127.0.0.1:11434/v1。
MODEL_API_BASE_URL=http://127.0.0.1:11434/v1
MODEL_API_KEY=
MODEL_NAME=qwen3:4b
MODEL_RESPONSE_FORMAT=json_schema
MODEL_TIMEOUT_MS=120000

# 本地 SQLite 用户学习状态服务。未配置时状态工具保持明确降级。
TRACE_TUTOR_SQLITE_SERVICE_URL=http://127.0.0.1:8000
TRACE_TUTOR_SQLITE_SERVICE_TOKEN=
TRACE_TUTOR_SQLITE_TIMEOUT_MS=5000

# PostgreSQL 题目资产库。连接用户应继承 tracetutor_asset_writer。
TRACE_TUTOR_PGSQL_URL=postgresql://tracetutor_app:change-me@127.0.0.1:5432/tracetutor
TRACE_TUTOR_PGSQL_MAX_CONNECTIONS=10
TRACE_TUTOR_PGSQL_TIMEOUT_MS=5000

# 内部或运维调用 /tools/* 时使用的服务端 Bearer Token。
# production 环境必须配置；不要放进 NEXT_PUBLIC_*。
TRACE_TUTOR_TOOL_TOKEN=
