      "title": "点关于空间直线的对称点",
      "stem": "求点 $P(2,-1,3)$ 关于直线\n$$L:\\frac{x-1}{1}=\\frac{y}{2}=\\frac{z+2}{-2}$$\n的对称点坐标。",
      "question_type": "calculation",
      "difficulty_level": 2,
      "answers": [
        {
          "answer_type": "symbolic",
          "answer_text": "$\\left(-\\frac{22}{9},-\\frac{35}{9},-\\frac{19}{9}\\right)$",
          "is_primary": true
        }
      ],
      "solutions": [
        {
          "title": "先求垂足再作中点反射",
          "solution_type": "teaching",
          "text": "直线过 $A=(1,0,-2)$，方向向量 $d=(1,2,-2)$。垂足 $H=A+td$ 中，$t=((P-A)\\cdot d)/(d\\cdot d)=-11/9$，故 $H=(-2/9,-22/9,4/9)$。对称点 $P'=2H-P=(-22/9,-35/9,-19/9)$。",
          "main_method_code": "orthogonal_projection_to_line",
          "is_primary": true,
          "steps": [
            {
              "order": 1,
              "role": "compute",
              "text": "由 $(P-H)\\cdot d=0$ 求得垂足参数 $t=-11/9$。",
              "method_code": "orthogonal_projection_to_line"
            },
            {
              "order": 2,
              "role": "compute",
              "text": "得到垂足 $H=(-2/9,-22/9,4/9)$。"
            },
            {
              "order": 3,
              "role": "conclude",
              "text": "利用 $H$ 是 $PP'$ 中点，计算 $P'=2H-P$。",
              "method_code": "midpoint_reflection"
            }
          ]
        }
      ],
