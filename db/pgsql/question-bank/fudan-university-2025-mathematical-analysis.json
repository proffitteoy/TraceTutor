      "subject": {
        "code": "mathematical_analysis",
        "chapter_code": "improper_integrals"
      },
      "title": "含周期零点因子的反常积分敛散性",
      "stem": "设 $\\alpha>\\beta>1$，讨论反常积分\n$$\\int_0^{+\\infty}\\frac{dx}{1+x^\\alpha|\\sin x|^\\beta}$$\n的敛散性。",
      "question_type": "proof",
      "difficulty_level": 4,
      "answers": [
        {
          "answer_type": "standard",
          "answer_text": "在 $\\alpha>\\beta>1$ 条件下该反常积分收敛。",
          "is_primary": true
        }
      ],
      "solutions": [
        {
          "title": "在正弦零点附近分区并缩放",
          "solution_type": "teaching",
          "text": "只需考察无穷远。把正半轴按 $k\\pi$ 的邻域分段，令 $u=x-k\\pi$。在 $|u|\\le\\pi/2$ 上有 $|\\sin x|\\ge(2/\\pi)|u|$，且 $x\\asymp k$，故第 $k$ 段积分不超过 $C\\int du/(1+k^\\alpha|u|^\\beta)$。作 $v=k^{\\alpha/\\beta}u$，该段为 $O(k^{-\\alpha/\\beta})$。因 $\\beta>1$ 保证缩放后的积分有限，且 $\\alpha/\\beta>1$，对 $k$ 求和收敛。",
          "main_method_code": "periodic_zero_localization",
          "is_primary": true,
          "steps": [
            {
              "order": 1,
              "role": "understand_problem",
              "text": "危险区域集中在无穷多个 $\\sin x$ 零点附近。"
            },
            {
              "order": 2,
              "role": "apply_method",
              "text": "按 $k\\pi$ 邻域分段，并用 $|\\sin u|\\ge2|u|/\\pi$。",
              "method_code": "periodic_zero_localization"
            },
            {
              "order": 3,
              "role": "transform",
              "text": "作尺度换元 $v=k^{\\alpha/\\beta}u$。",
              "method_code": "scaling_substitution"
            },
            {
              "order": 4,
              "role": "conclude",
              "text": "各段为 $O(k^{-\\alpha/\\beta})$，因 $\\alpha/\\beta>1$ 而可求和。"
            }
          ]
        }
      ],
