      "title": "含 n 次根的幂指型数列极限",
      "stem": "求极限\n$$\\lim_{n\\to\\infty}\\left(\\frac{1+\\sqrt[n]{2025}}{2}\\right)^n.$$",
      "question_type": "calculation",
      "difficulty_level": 2,
      "answers": [
        {
          "answer_type": "numeric",
          "answer_text": "$45$",
          "is_primary": true
        }
      ],
      "solutions": [
        {
          "title": "指数展开后取对数",
          "solution_type": "teaching",
          "text": "由 $2025^{1/n}=e^{(\\ln2025)/n}=1+(\\ln2025)/n+O(n^{-2})$，底数为 $1+(\\ln2025)/(2n)+O(n^{-2})$。取对数并乘以 $n$，极限为 $\\frac12\\ln2025$，故原式为 $e^{\\frac12\\ln2025}=\\sqrt{2025}=45$。",
          "main_method_code": "logarithmic_transform",
          "is_primary": true,
          "steps": [
            {
              "order": 1,
              "role": "transform",
              "text": "把 $n$ 次根写成指数形式并展开。"
            },
            {
              "order": 2,
              "role": "apply_method",
              "text": "对整个幂指表达式取对数。",
              "method_code": "logarithmic_transform"
            },
            {
              "order": 3,
              "role": "conclude",
              "text": "对数极限为 $\\frac12\\ln2025$，还原得到 $45$。"
            }
          ]
        }
      ],
