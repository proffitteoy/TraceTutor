      "question_type": "calculation",
      "difficulty_level": 4,
      "answers": [
        {
          "answer_type": "standard",
          "answer_text": "$f(0)=0$，$f'(0)=0$，$f''(0)=4$；最后一个极限为 $e^2$。",
          "is_primary": true
