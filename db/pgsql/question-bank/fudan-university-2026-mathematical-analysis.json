    {
      "schema_version": "1.0",
      "external_id": "fudan-2026-ma-007",
      "source": {
        "type": "exam",
        "title": "复旦大学 2026 年数学分析试卷",
        "reference": "第7题；解析文件第461—544行",
        "license_note": "原始材料未提供授权说明，正式使用前需人工确认"
      },
      "subject": {
        "code": "mathematical_analysis",
        "chapter_code": "function_series"
      },
      "title": "Riemann ζ 函数的光滑性与积分敛散性",
      "stem": "已知\n$$\\zeta(x)=\\sum_{n=1}^{\\infty}\\frac1{n^x}.$$\n证明 $\\zeta$ 在 $(1,+\\infty)$ 上任意阶可导，并判断\n$$\\int_1^{+\\infty}(\\zeta(x)-1)\\,dx$$\n的敛散性。",
      "question_type": "proof",
      "difficulty_level": 4,
      "answers": [
        {
          "answer_type": "standard",
          "answer_text": "对 $k\\ge1$，$\\zeta^{(k)}(x)=\\sum_{n=2}^{\\infty}(-\\ln n)^kn^{-x}$；所给反常积分发散。",
          "is_primary": true
        }
      ],
      "solutions": [
        {
          "title": "紧子区间一致控制并用 Tonelli 交换",
          "solution_type": "teaching",
          "text": "在任意紧子区间 $[1+\\delta,M]$ 上，第 $k$ 阶形式导数的绝对值由 $(\\ln n)^k/n^{1+\\delta}$ 控制，而该数项级数收敛。因此可逐阶逐项求导，得到任意阶可导。又 $\\zeta(x)-1=\\sum_{n=2}^\\infty n^{-x}\\ge0$，Tonelli 定理给出积分等于 $\\sum_{n=2}^\\infty\\int_1^\\infty n^{-x}dx=\\sum_{n=2}^\\infty1/(n\\ln n)$，该级数发散。",
          "main_method_code": "local_uniform_derivative_series",
          "is_primary": true,
          "steps": [
            {
              "order": 1,
              "role": "apply_method",
              "text": "在每个 $[1+\\delta,M]$ 上用可求和的 $(\\ln n)^k/n^{1+\\delta}$ 控制导数项。",
              "method_code": "local_uniform_derivative_series"
            },
            {
              "order": 2,
              "role": "conclude",
              "text": "逐阶应用函数项级数求导定理，得到 $C^\\infty$ 性。",
              "knowledge_point_code": "termwise_differentiation"
