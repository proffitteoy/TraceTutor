              "order": 2,
              "role": "compute",
              "text": "在矩阵单位基下计算 $T(E_{ij})$。"
            },
            {
              "order": 3,
              "role": "compute",
              "text": "得到 $r(T)=2$、$r(T^2)=1$、$T^3=0$。",
              "method_code": "nilpotent_rank_sequence"
            },
            {
              "order": 4,
              "role": "conclude",
              "text": "幂零块为 $J_3(0)\\oplus J_1(0)$，平移后即为 $J_3(2024^2)\\oplus J_1(2024^2)$。"
            }
          ]
