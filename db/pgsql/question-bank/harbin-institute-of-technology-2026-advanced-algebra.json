      "difficulty_level": 2,
      "answers": [
        {
          "answer_type": "standard",
          "answer_text": "命题不成立。例如\n$$A=\\begin{pmatrix}1&1\\\\2&-2\\end{pmatrix}$$\n的两行正交，但两列内积为 $-3$。",
          "is_primary": true
        }
      ],
      "solutions": [
        {
          "title": "构造不等长正交行反例",
          "solution_type": "teaching",
          "text": "行向量两两正交只说明 $AA^T$ 为对角矩阵，并不保证 $A^TA$ 为对角矩阵。取 $A=\\begin{pmatrix}1&1\\\\2&-2\\end{pmatrix}$，两行内积为零；两列分别为 $(1,2)^T$、$(1,-2)^T$，内积为 $1-4=-3$，故命题为假。",
          "main_method_code": "explicit_counterexample",
          "is_primary": true,
          "steps": [
            {
              "order": 1,
              "role": "understand_problem",
              "text": "区分 $AA^T$ 对角与 $A^TA$ 对角两个条件。",
              "knowledge_point_code": "row_column_orthogonality"
            },
            {
              "order": 2,
              "role": "apply_method",
              "text": "选择两条正交但长度不同的行向量。",
              "method_code": "explicit_counterexample"
            },
            {
              "order": 3,
              "role": "check",
              "text": "直接计算两列内积不为零。"
            }
          ]
        }
