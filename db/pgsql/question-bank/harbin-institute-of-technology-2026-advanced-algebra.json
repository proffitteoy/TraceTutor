            {
              "order": 2,
              "role": "understand_problem",
              "text": "把满行秩解释为 $A:\\mathbb R^n\\to\\mathbb R^m$ 满射。",
              "knowledge_point_code": "right_inverse"
            },
            {
              "order": 3,
              "role": "apply_method",
              "text": "为每个标准基选择原像并作为 $X$ 的列。",
              "method_code": "choose_preimages_as_columns"
