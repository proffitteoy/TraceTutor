      "title": "满足两个四重同余条件的七次多项式",
      "stem": "求七次多项式 $f(x)$，使 $f(x)+1$ 能被 $(x-1)^4$ 整除，且 $f(x)-1$ 能被 $(x+1)^4$ 整除。",
      "question_type": "calculation",
      "difficulty_level": 4,
      "answers": [
        {
          "answer_type": "symbolic",
          "answer_text": "$$f(x)=\\frac{5x^7-21x^5+35x^3-35x}{16}.$$",
          "is_primary": true
        }
      ],
      "solutions": [
        {
          "title": "利用对称性化为奇多项式插值",
          "solution_type": "teaching",
          "text": "模 $(x-1)^4$ 与模 $(x+1)^4$ 的条件在次数小于 $8$ 的多项式中给出唯一解。若 $f$ 是解，则 $-f(-x)$ 也是解，故唯一性推出 $f$ 为奇函数。写 $f=ax+bx^3+cx^5+dx^7$。由 $f(1)=-1$ 及 $f'(1)=f''(1)=f'''(1)=0$ 解得 $(a,b,c,d)=(-35,35,-21,5)/16$。奇性自动保证 $x=-1$ 处的另一组四重条件。",
          "main_method_code": "odd_hermite_interpolation",
          "is_primary": true,
          "steps": [
            {
              "order": 1,
              "role": "understand_problem",
              "text": "将两个整除条件改写为在 $\\pm1$ 处的函数值和前三阶导数条件。",
              "knowledge_point_code": "hermite_interpolation"
            },
            {
              "order": 2,
              "role": "apply_method",
              "text": "由解的唯一性和关于原点的对称性推出 $f$ 为奇多项式。",
              "method_code": "odd_hermite_interpolation"
            },
            {
              "order": 3,
              "role": "compute",
              "text": "代入 $f=ax+bx^3+cx^5+dx^7$ 并解四个线性方程。"
            },
            {
              "order": 4,
              "role": "check",
              "text": "检查在 $x=1$ 与 $x=-1$ 处均满足四重同余。"
            }
          ]
        }
      ],
