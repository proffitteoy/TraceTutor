          "main_method_code": "quotient_space_linear_dependence",
          "is_primary": true,
          "steps": [
            {
              "order": 1,
              "role": "transform",
              "text": "在 $\\mathbb Q[x]/(x^3+6x+1)$ 中化简 $x^4,x^6$。",
              "knowledge_point_code": "polynomial_quotient_space"
            },
            {
              "order": 2,
              "role": "compute",
              "text": "令余式的常数、一次和二次项系数均为零。"
            },
            {
              "order": 3,
              "role": "check",
              "text": "给出显式因式分解验证。",
              "method_code": "quotient_space_linear_dependence"
            }
          ]
        }
      ],
      "knowledge_points": [
