            },
            {
              "order": 2,
              "role": "compute",
              "text": "上界为 $(\\sqrt8)^8=4096$。"
            },
            {
              "order": 3,
              "role": "check",
              "text": "以八阶 Sylvester Hadamard 矩阵说明上界可达。",
