# TraceTutor SQLite runtime file. Do not commit generated DB/WAL/SHM files.
TRACE_TUTOR_SQLITE_PATH=data/tracetutor_state.db
TRACE_TUTOR_STATE_ENV=development
TRACE_TUTOR_STATE_CORS_ORIGINS=
TRACE_TUTOR_STATE_LOG_LEVEL=INFO
# Shared only with apps/api. Required in production.
TRACE_TUTOR_SQLITE_SERVICE_TOKEN=
TRACE_TUTOR_SQLITE_MIGRATIONS_DIR=

# Cross-database ID validation:
# off    = only non-empty IDs (standalone/local development)
# format = require PgSQL UUID string format
# http   = call the PgSQL asset service /validate-reference endpoint
TRACE_TUTOR_ASSET_VALIDATION_MODE=off
TRACE_TUTOR_ASSET_VALIDATION_URL=
TRACE_TUTOR_ASSET_VALIDATION_TOKEN=
TRACE_TUTOR_ASSET_VALIDATION_TIMEOUT_SECONDS=3.0
